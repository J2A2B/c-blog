---
import { AUTHOR_BIO, AUTHOR_NAME, AUTHOR_PATH, AUTHOR_ROLE } from '../consts';
---

<aside class="editorial-card" aria-labelledby="editorial-card-title">
	<div class="editorial-avatar" aria-hidden="true">CA</div>
	<div class="editorial-content">
		<p class="editorial-label">À propos de la rédaction</p>
		<h2 id="editorial-card-title">
			<a href={AUTHOR_PATH} rel="author">{AUTHOR_NAME}</a>
		</h2>
		<p class="editorial-role">{AUTHOR_ROLE}</p>
		<p class="editorial-bio">{AUTHOR_BIO}</p>
		<a class="editorial-link" href={AUTHOR_PATH} rel="author">
			Découvrir notre méthode éditoriale
		</a>
	</div>
</aside>

<style>
	.editorial-card {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1rem;
		margin-top: 3rem;
		padding: 1.25rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: white;
		box-shadow: 0 6px 20px rgba(var(--black), 6%);
	}
	.editorial-avatar {
		display: grid;
		width: 4rem;
		height: 4rem;
		place-items: center;
		border-radius: 50%;
		background: var(--accent-dark);
		color: white;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	.editorial-content p {
		margin: 0;
	}
	.editorial-label {
		color: rgb(var(--gray));
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.editorial-content h2 {
		margin: 0.15rem 0 0;
		font-size: 1.35rem;
	}
	.editorial-content h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.editorial-content h2 a:hover {
		color: var(--accent);
	}
	.editorial-role {
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.editorial-bio {
		margin-top: 0.75rem !important;
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.editorial-link {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: 0.9rem;
		font-weight: 700;
	}
	@media (max-width: 540px) {
		.editorial-card {
			grid-template-columns: 1fr;
		}
	}
</style>
