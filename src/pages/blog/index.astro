---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { CATEGORY_CONFIG } from '../../lib/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Blog — Conseils et guides pour chat d'appartement | ${SITE_TITLE}`}
			description="Tous nos articles sur la vie du chat en appartement : alimentation, enrichissement, litière, santé et matériel testé."
		/>
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				display: block;
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h2,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
			.categories-nav {
				margin: 0 0 2em 0;
				padding: 1em;
				background: white;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.categories-nav p {
				margin: 0 0 0.5em 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.categories-nav .categories-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
			}
			.categories-nav a {
				text-decoration: none;
				color: rgb(var(--accent));
				font-weight: bold;
			}
			.categories-nav a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog chat d'appartement : tous nos articles</h1>
			<nav class="categories-nav" aria-label="Catégories d'articles">
				<p>Parcourir par catégorie :</p>
				<div class="categories-list">
					{
						CATEGORY_CONFIG.map((category) => (
							<a href={`/blog/categorie/${category.slug}/`}>{category.label}</a>
						))
					}
				</div>
			</nav>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
