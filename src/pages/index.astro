---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import HeroCat from '../assets/chaton-hero-appartement.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import WebsiteSchema from '../components/WebsiteSchema.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Guides et conseils pour chat d'intérieur`}
			description={SITE_DESCRIPTION}
			image={HeroCat}
			imageAlt="Chaton confortablement installé sur un canapé en appartement"
		/>
		<WebsiteSchema />
		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2em);
			}
			.hero {
				margin: 0 0 2.5em 0;
			}
			.hero-image {
				border-radius: 12px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				margin-bottom: 1.2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 420px;
				object-fit: cover;
				border-radius: 0;
				margin: 0;
			}
			.hero-text h1 {
				margin-bottom: 0.3em;
			}
			.hero-text p {
				margin: 0;
				max-width: 42em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.hero-image img {
					max-height: 280px;
				}
			}
			.post-list {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-list li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-list li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.post-list li a {
				display: block;
			}
			.post-title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.post-date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-list li a:hover h3,
			.post-list li a:hover .post-date {
				color: rgb(var(--accent));
			}
			.post-list a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 980px) {
				.post-list {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 720px) {
				.post-list {
					grid-template-columns: 1fr;
					gap: 0.5em;
				}
				.post-list li {
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-image">
					<Image
						src={HeroCat}
						alt="Chaton confortablement installé sur un canapé en appartement"
						width={1200}
						height={420}
					/>
				</div>
				<div class="hero-text">
					<h1>Chat d'appartement : guide complet pour son bien-être en intérieur</h1>
					<p>{SITE_DESCRIPTION}</p>
				</div>
			</section>

			<section>
				<h2>Derniers articles</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
